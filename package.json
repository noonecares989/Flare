    "@types/react-dom": "^18.3.0",
    "three": "^0.163.0",
    "@react-three/fiber": "^8.15.0",
    "@react-three/drei": "^9.96.0",
    "@react-three/postprocessing": "^2.15.0",
    "gsap": "^3.12.0",
    "@react-spring/three": "^9.7.3",
    "@react-spring/web": "^9.7.3",
